{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py session-start {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py pre-compact {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py post-compact {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py stop-failure {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py session-end {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
