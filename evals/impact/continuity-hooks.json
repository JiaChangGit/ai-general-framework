      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py pre-model-switch {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py stop {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 {framework}/templates/claude-continuity-hook.py user-prompt {framework}/evals/impact/continuity-config.json",
            "timeout": 10
          }
        ]
      }
    ]
