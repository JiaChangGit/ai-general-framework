---
config:
  look: neo
  theme: neutral
  fontFamily: 'Noto Sans CJK TC, Microsoft JhengHei, PingFang TC, sans-serif'
---
%% 虛構分層樣板；元件與箭頭須換成已確認的系統關係。
flowchart LR
    subgraph AppLayer["應用層"]
        App["APP"]
        Cli["CLI"]
    end
    subgraph CoreLayer["服務層"]
        Core["共用服務"]
    end
    subgraph DriverLayer["介面層"]
        Driver["驅動介面"]
    end
    subgraph DeviceLayer["控制層"]
        Device["裝置控制"]
    end
    subgraph InfraLayer["基礎設施"]
        Hardware["硬體"]
    end
    App --> Core
    Cli --> Core
    Core --> Driver --> Device --> Hardware
    classDef app fill:#e8d5f5,stroke:#7b2d8e,stroke-width:2px,color:#333
    classDef core fill:#d5e8f5,stroke:#2d6e8e,stroke-width:2px,color:#333
    classDef driver fill:#d5f5e8,stroke:#2d8e6e,stroke-width:1.5px,color:#333
    classDef device fill:#f5e8d5,stroke:#8e6e2d,stroke-width:1.5px,color:#333
    classDef infra fill:#f0f0f0,stroke:#888,stroke-width:1px,stroke-dasharray:5 5,color:#555
    classDef subgrp fill:none,stroke:none
    class App,Cli app
    class Core core
    class Driver driver
    class Device device
    class Hardware infra
    class AppLayer,CoreLayer,DriverLayer,DeviceLayer,InfraLayer subgrp
